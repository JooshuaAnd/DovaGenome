# terjangkau dari jaringan ini. Region terdeteksi: ap-southeast-1 (Singapore).
# Ambil string lengkap di Supabase Dashboard → Connect → Session pooler.
SUPABASE_DB_API_ENDPOINT=""
SUPABASE_DB_USER=""
# PENTING: harus DATABASE PASSWORD (Dashboard → Project Settings → Database →
# Reset database password), BUKAN secret key sb_secret_ / service_role.
# Nilai sb_secret lama dipindah ke komentar di bawah agar tidak hilang:
SUPABASE_DB_APPLICATION_TOKEN=""
