# ── Telegram ───────────────────────────────────────────────────────────────
# Nama lama (dipakai bot Streamlit lama) tetap diterima backend.
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
# Alias baru yang lebih eksplisit (backend lebih mengutamakan ini).
TELEGRAM_BOT_TOKEN=

# ── Langflow ───────────────────────────────────────────────────────────────
LANGFLOW_API_KEY=
LANGFLOW_FLOW_ID=
# Base API saja sudah cukup; backend menyusun sendiri URL `/run/<flow_id>`.
# URL lengkap yang sudah memuat `/run` juga diterima.
LANGFLOW_API_URL=http://127.0.0.1:7860/api/v1
LANGFLOW_TIMEOUT_SECONDS=30
LANGFLOW_MAX_RETRIES=1

# ── Astra DB ───────────────────────────────────────────────────────────────
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# ── Aplikasi ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth ───────────────────────────────────────────────────────────────────
# WAJIB diganti di produksi. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# MVP: customer tanpa password bisa login dengan username saja.
# WAJIB false di produksi.
ALLOW_PASSWORDLESS_LOGIN=true
TELEGRAM_LINK_CODE_TTL_MINUTES=10

# ── Data ───────────────────────────────────────────────────────────────────
CATALOG_CACHE_TTL_SECONDS=120
# Jangan pernah true di produksi — data contoh tidak boleh masuk papan dapur.
DEMO_MODE=false
DEFAULT_CURRENCY=IDR