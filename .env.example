ALLOW_PASSWORDLESS_LOGIN=true
DEMO_MODE=false
CATALOG_CACHE_TTL_SECONDS=120
TELEGRAM_LINK_CODE_TTL_MINUTES=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

