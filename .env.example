# Pooler IPv4 — host langsung db.<ref>.supabase.co hanya IPv6 sehingga tidak
# terjangkau dari jaringan ini. Region terdeteksi: ap-southeast-1 (Singapore).
# Ambil string lengkap di Supabase Dashboard → Connect → Session pooler.
SUPABASE_DB_API_ENDPOINT=""
SUPABASE_DB_USER=""
# PENTING: harus DATABASE PASSWORD (Dashboard → Project Settings → Database →
# Reset database password), BUKAN secret key sb_secret_ / service_role.
# Nilai sb_secret lama dipindah ke komentar di bawah agar tidak hilang:
SUPABASE_DB_APPLICATION_TOKEN=""
LANGFLOW_FLOW_ID=
LANGFLOW_API_URL=
LANGFLOW_INTERNAL_TOKEN=
LANGFLOW_TIMEOUT_SECONDS=30
AI_MODE=required_langflow
LANGFLOW_RECIPE_TIMEOUT_SECONDS=180
# AI-assisted Recipe Verification (foto + pencarian web), dipakai hanya backend.
OPENAI_API_KEY=
API_KEY_ADMIN= # Credential AI khusus admin; terpisah dari LANGFLOW_API_KEY.
OPENAI_RECIPE_MODEL=gpt-4.1-mini
OPENAI_RECIPE_WEB_SEARCH=true
OPENAI_RECIPE_TIMEOUT_SECONDS=45
